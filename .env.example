# =============================================================================
# SSDLC Platform — Environment Variables
# Copy this file to .env and fill in your values.
# .env is in .gitignore — never commit real secrets.
# =============================================================================

# --- LLM Provider (single flag to switch between local Ollama and Gemini API) ---
# Values: "ollama" (local, Metal GPU) | "gemini" (Google Gemini API, cloud)
LLM_PROVIDER=ollama

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ssdlc
DB_USER=postgres
DB_PASSWORD=

# --- Ollama (runs natively on Mac) — active when LLM_PROVIDER=ollama ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIER1_MODEL=qwen2.5-coder:14b-instruct-q5_K_M
OLLAMA_TIER2_MODEL=llama3.2:3b

# --- Google Gemini API — active when LLM_PROVIDER=gemini ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_TIER1_MODEL=gemini-2.0-flash
GEMINI_TIER2_MODEL=gemini-2.0-flash-lite

# --- Semgrep ---
# Detection rules: Semgrep-format YAML — passed as --config to Semgrep for vulnerability detection
SEMGREP_DETECTION_RULES_PATH=./agents/security/sast/rules
# FP filter rules: Python Layer 1 format — loaded by core/fp_pipeline/layer1_rules.py (NOT passed to Semgrep)
SEMGREP_RULES_PATH=./agents/security/sast/fp_rules.yml
SEMGREP_DOCKER_IMAGE=semgrep/semgrep:latest
SEMGREP_TIMEOUT=300
SEMGREP_MAX_FINDINGS=1000

# --- API Server ---
API_HOST=0.0.0.0
API_PORT=8080

# --- Prompts ---
PROMPTS_DIR=./prompts

# --- Watchdog ---
WATCHDOG_INTERVAL=300
WATCHDOG_SLA_PENDING=1800
WATCHDOG_SLA_PROCESSING=3600

# --- Models path (air-gap: set to local directory with downloaded models) ---
# MODELS_PATH=/opt/models
# UNIXCODER_MODEL=microsoft/unixcoder-base

# --- Phase 1+ (leave blank for Phase 0) ---
# GITEA_URL=http://ssdlc-platform.local:3000
# VAULT_ADDR=http://ssdlc-platform.local:8200
# VAULT_TOKEN=
